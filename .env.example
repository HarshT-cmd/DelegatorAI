DATABASE_PATH=delegatorai.db
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# Set the exact public HTTPS endpoint URL configured in the Google Chat app.
CHAT_AUDIENCE=
# Optional for local use. Cloud Run uses its runtime service account via ADC.
# If set locally, point to a protected service account JSON file outside the repo.
CHAT_SERVICE_ACCOUNT_FILE=
# Optional. If set, require this email in Google's verified OIDC token.
CHAT_EXPECTED_SERVICE_ACCOUNT_EMAIL=
# JSON object mapping each project_id to its Google Chat space resource name.
# Example: {"college-app":"spaces/AAAA..."}
CHAT_PROJECT_SPACES={}
